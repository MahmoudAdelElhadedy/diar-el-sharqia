@echo off
chcp 65001 > nul
echo ================================================================
echo   جاري رفع مشروع ديار الشرقية إلى GitHub...
echo ================================================================
echo.
cd /d "%~dp0"

echo 1. التحقق من حالة المستودع المحلي...
git status -s

echo.
echo 2. جاري الرفع إلى الفرع الرئيسي (main)...
git push -u origin main

echo.
if %errorlevel% equ 0 (
    echo ================================================================
    echo  تم الرفع بنجاح إلى GitHub!
    echo  يقوم الآن GitHub Actions ببناء ونشر الموقع تلقائياً.
    echo  رابط الموقع سيكون متاحاً خلال دقيقتين على:
    echo  https://MahmoudAdelElhadedy.github.io/diar-el-sharqia/
    echo ================================================================
) else (
    echo ================================================================
    echo  حدث خطأ أثناء الرفع، يُرجى التأكد من تسجيل الدخول إلى GitHub.
    echo ================================================================
)
echo.
pause
